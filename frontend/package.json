    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
